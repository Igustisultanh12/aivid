# ==============================================================================
# RUANG DHARMA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# PERHATIAN: Google Gemini API Key TIDAK DITULISKAN di file .env ini.
# Kunci API Gemini disimpan terenkripsi (AES-256) melalui web Dashboard Admin
# pada menu: /admin/settings/gemini.
# ==============================================================================

APP_NAME="Ruang Dharma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ruangdharma.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL Direkomendasikan, atau SQLite untuk Lokal)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ruangdharma_db
DB_USERNAME=ruangdharma_user
DB_PASSWORD=GantiDenganPasswordKuat

# ------------------------------------------------------------------------------
# CACHE, SESSION & QUEUE (REDIS)
# ------------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# LARAVEL REVERB (REAL-TIME WEBSOCKET FOR VIDEO GENERATION PROGRESS)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=ruang-dharma-app
REVERB_APP_KEY=rd-reverb-prod-key
REVERB_APP_SECRET=rd-reverb-prod-secret
REVERB_HOST="ruangdharma.com"
REVERB_PORT=443
REVERB_SCHEME="https"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
# MEDIA RENDERING ENGINE (FFmpeg & FFprobe)
# ------------------------------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ------------------------------------------------------------------------------
# EMAIL SERVICE (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@ruangdharma.com"
MAIL_FROM_NAME="Ruang Dharma"
